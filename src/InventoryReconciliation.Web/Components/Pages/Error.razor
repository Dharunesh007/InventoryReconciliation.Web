@page "/error"
@attribute [AllowAnonymous]

<MudPaper Class="empty-state" Elevation="0">
    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" />
    <MudText Typo="Typo.h5">Something went wrong</MudText>
    <MudText Typo="Typo.body2">The error was captured for support review. Please retry the operation.</MudText>
</MudPaper>
