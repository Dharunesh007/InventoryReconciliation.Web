@page "/"
@inject IUploadedInventorySource UploadedInventorySource
@inject IAssetEditStore AssetEditStore

<PageHeader Eyebrow="Executive command" Title="Inventory Verification Command Center" Summary="@HeaderSummary">
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">Refresh Workbook</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile" Href="/inventory-upload">Review Upload</MudButton>
</PageHeader>

@if (_snapshot is null)
{
    <MudPaper Class="empty-state" Elevation="0">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <MudText Typo="Typo.h6">Loading uploaded workbook</MudText>
    </MudPaper>
}
else if (_snapshot.TotalRows == 0)
{
    <MudPaper Class="empty-state" Elevation="0">
        <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Large" />
        <MudText Typo="Typo.h5">No uploaded inventory found</MudText>
        <MudText Typo="Typo.body2">Configured workbook path: @_snapshot.SourcePath</MudText>
    </MudPaper>
}
else
{
    <section class="stat-band">
        <div class="hero-meter">
            <MudText Typo="Typo.overline" Class="eyebrow">Physical verification readiness</MudText>
            <div class="hero-meter-value">
                <strong>@ReconciledPercent%</strong>
                <span>asset edits saved</span>
            </div>
            <div class="wave-track" style="@($"--value:{ReconciledPercent}%")">
                <span></span>
            </div>
            <MudText Typo="Typo.body2" Class="muted">@_savedAssetEditCount.ToString("N0") assets have saved Explorer corrections, with @_totalChangePointCount.ToString("N0") tracked physical verification change points.</MudText>
        </div>
        <div class="hero-snapshot">
            <div class="snapshot-tile">
                <span>Source workbook</span>
                <strong>@_snapshot.SourceFileName</strong>
            </div>
            <div class="snapshot-tile">
                <span>Last modified</span>
                <strong>@LastModifiedText</strong>
            </div>
            <div class="snapshot-tile">
                <span>Columns profiled</span>
                <strong>@_snapshot.TotalColumns.ToString("N0")</strong>
            </div>
            <div class="snapshot-tile">
                <span>Verification cases</span>
                <strong>@_savedAssetEditCount.ToString("N0")</strong>
            </div>
        </div>
    </section>

    <MudGrid Class="dashboard-grid">
        @foreach (var metric in Metrics)
        {
            <MudItem xs="12" sm="6" md="3">
                <MetricTile Label="@metric.Label" Value="@metric.Value" Delta="@metric.Delta" Accent="@metric.Accent" Icon="@metric.Icon" Trend="@metric.Trend" Tone="@metric.Tone" Progress="@metric.Progress" />
            </MudItem>
        }
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" lg="8">
            <MudPaper Class="workspace-panel change-summary-panel" Elevation="0">
                <div class="panel-title-row">
                    <div>
                        <MudText Typo="Typo.h6">Physical Verification Change Summary</MudText>
                        <MudText Typo="Typo.body2" Class="muted">Counts from saved Asset Explorer edits: location, sticker, user, serial, status, and other reconciliation changes.</MudText>
                    </div>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">@_totalChangePointCount changes</MudChip>
                </div>

                @if (_totalChangePointCount == 0)
                {
                    <div class="empty-chart-state">
                        <MudIcon Icon="@Icons.Material.Filled.StackedBarChart" />
                        <div>
                            <strong>No tracked change points yet</strong>
                            <span>Edit and save an asset in Asset Explorer to classify changes like Location Change, Sticker Mismatch, or User Mismatch.</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="change-summary-chart" aria-label="Physical verification change point summary">
                        @foreach (var item in ChangeSummaryRows)
                        {
                            <div class="change-summary-row">
                                <div class="change-label">
                                    <span class="@($"change-dot tone-{item.Tone}")"></span>
                                    <div>
                                        <strong>@item.Name</strong>
                                        <small>@item.Count.ToString("N0") saved change@(item.Count == 1 ? string.Empty : "s")</small>
                                    </div>
                                </div>
                                <div class="change-track">
                                    <span class="@($"tone-{item.Tone}")" style="@($"width:{item.Percent}%")"></span>
                                </div>
                                <b>@item.Percent%</b>
                            </div>
                        }
                    </div>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="4">
            <MudPaper Class="workspace-panel" Elevation="0">
                <div class="panel-title-row">
                    <div>
                        <MudText Typo="Typo.h6">Change Intelligence</MudText>
                        <MudText Typo="Typo.body2" Class="muted">Latest saved corrections from the editable master grid.</MudText>
                    </div>
                    <StatusPill Text="@ChangePulseText" Tone="@(_totalChangePointCount == 0 ? "neutral" : "success")" />
                </div>
                <div class="change-intelligence-stack">
                    <div class="change-intelligence-tile">
                        <span>Most common change</span>
                        <strong>@TopChangeText</strong>
                    </div>
                    <div class="change-intelligence-tile">
                        <span>Latest edit</span>
                        <strong>@LatestEditText</strong>
                    </div>
                    <div class="change-intelligence-tile">
                        <span>Edited assets</span>
                        <strong>@_savedAssetEditCount.ToString("N0")</strong>
                    </div>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" lg="8">
            <MudPaper Class="workspace-panel" Elevation="0">
                <div class="panel-title-row">
                    <div>
                        <MudText Typo="Typo.h6">Asset Type Distribution</MudText>
                        <MudText Typo="Typo.body2" Class="muted">Counts from your uploaded workbook only</MudText>
                    </div>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">@_snapshot.TotalRows rows</MudChip>
                </div>
                <div class="trend-chart" aria-label="Uploaded asset type distribution">
                    @foreach (var item in AssetTypeBars)
                    {
                        <div class="trend-column">
                            <div class="bar-stack">
                                <span class="bar-value">@item.Count.ToString("N0")</span>
                                <span class="verified-bar" style="@($"height:{item.Height}px")"></span>
                            </div>
                            <small title="@item.Label">@item.Label</small>
                        </div>
                    }
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="4">
            <MudPaper Class="workspace-panel" Elevation="0">
                <div class="panel-title-row">
                    <div>
                        <MudText Typo="Typo.h6">Uploaded Status Mix</MudText>
                        <MudText Typo="Typo.body2" Class="muted">No verification variances have been invented</MudText>
                    </div>
                </div>
                @foreach (var item in StatusMix)
                {
                    <div class="progress-row">
                        <div>
                            <strong>@item.Name</strong>
                            <span>@item.Count assets</span>
                        </div>
                        <MudProgressLinear Value="@item.Percent" Rounded="true" Color="@item.Color" />
                    </div>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" md="7">
            <MudPaper Class="workspace-panel" Elevation="0">
                <MudText Typo="Typo.h6">Location / Floor Summary</MudText>
                <div class="heatmap">
                    @foreach (var zone in TopLocations)
                    {
                        <div class="heat-cell" style="@($"--heat:{zone.Heat}")">
                            <strong>@zone.Name</strong>
                            <span>@zone.Count assets</span>
                        </div>
                    }
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="5">
            <MudPaper Class="workspace-panel" Elevation="0">
                <div class="panel-title-row">
                    <div>
                        <MudText Typo="Typo.h6">Upload Data Quality</MudText>
                        <MudText Typo="Typo.body2" Class="muted">Guardrails are computed from the workbook. Nothing here is demo-generated.</MudText>
                    </div>
                </div>
                @foreach (var risk in UploadFindings)
                {
                    <div class="risk-row">
                        <MudIcon Icon="@risk.Icon" Color="@risk.Color" />
                        <div>
                            <strong>@risk.Title</strong>
                            <span>@risk.Detail</span>
                        </div>
                        <StatusPill Text="@risk.Status" Tone="@risk.Tone" />
                    </div>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" lg="7">
            <MudPaper Class="workspace-panel" Elevation="0">
                <div class="panel-title-row">
                    <div>
                        <MudText Typo="Typo.h6">Department Concentration</MudText>
                        <MudText Typo="Typo.body2" Class="muted">High-density view of ownership clusters from uploaded rows.</MudText>
                    </div>
                </div>
                @foreach (var item in DepartmentMix)
                {
                    <div class="progress-row">
                        <div>
                            <strong>@item.Name</strong>
                            <span>@item.Count assets</span>
                        </div>
                        <MudProgressLinear Value="@item.Percent" Rounded="true" Color="Color.Secondary" />
                    </div>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="5">
            <MudPaper Class="workspace-panel" Elevation="0">
                <div class="panel-title-row">
                    <div>
                        <MudText Typo="Typo.h6">Reconciliation Activity</MudText>
                        <MudText Typo="Typo.body2" Class="muted">@(_savedAssetEditCount == 0 ? "No saved Explorer corrections yet." : "Latest saved Explorer corrections from your uploaded inventory.")</MudText>
                    </div>
                    <StatusPill Text="@ChangePulseText" Tone="@(_totalChangePointCount == 0 ? "neutral" : "success")" />
                </div>
                <div class="activity-stream">
                    <div class="activity-item">
                        <span class="activity-icon"><MudIcon Icon="@Icons.Material.Filled.TableRows" /></span>
                        <div>
                            <strong>Workbook loaded</strong>
                            <div class="activity-note">@_snapshot.TotalRows.ToString("N0") uploaded asset rows are available for search, verification, and reporting.</div>
                        </div>
                    </div>
                    @if (_editEntries.Count == 0)
                    {
                        <div class="activity-item">
                            <span class="activity-icon"><MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" /></span>
                            <div>
                                <strong>Awaiting first verification</strong>
                                <div class="activity-note">Edit and save an asset to start the change summary.</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (var entry in _editEntries.Take(3))
                        {
                            <div class="activity-item">
                                <span class="activity-icon"><MudIcon Icon="@Icons.Material.Filled.EditNote" /></span>
                                <div>
                                    <strong>@entry.AssetTag saved</strong>
                                    <div class="activity-note">@entry.SavedAtUtc.ToLocalTime().ToString("MMM dd, HH:mm") - @((entry.Changes ?? []).Length) classified change point@((entry.Changes ?? []).Length == 1 ? string.Empty : "s")</div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly string[] CoreChangeOrder =
    [
        "Location Change",
        "Sticker Mismatch",
        "User Mismatch",
        "Serial Mismatch",
        "Department Change",
        "Status Change",
        "Asset Type Variance",
        "Custodian Change",
        "Device Details Change",
        "Warranty Change",
        "Classification Change",
        "Security Posture Change",
        "Commercial Data Change",
        "Audit Remarks Update"
    ];

    private UploadedInventorySnapshot? _snapshot;
    private IReadOnlyList<AssetEditEntry> _editEntries = [];
    private IReadOnlyList<ChangeSummaryRow> _changeSummaryRows = [];
    private int _savedAssetEditCount => _editEntries.Count;
    private int _totalChangePointCount => _changeSummaryRows.Sum(row => row.Count);
    private int ReconciledPercent => Percent(_savedAssetEditCount, _snapshot?.TotalRows ?? 0);

    private string HeaderSummary => _snapshot is null
        ? "Loading the workbook you uploaded."
        : $"Live from {_snapshot.SourceFileName}: {_snapshot.TotalRows:N0} asset rows, {_snapshot.TotalColumns:N0} profiled columns, no synthetic records.";

    private string LastModifiedText =>
        _snapshot?.SourceLastModified?.ToLocalTime().ToString("MMM dd, HH:mm") ?? "Unknown";

    private string ChangePulseText =>
        _totalChangePointCount == 0 ? "Waiting" : "Tracking";

    private string TopChangeText =>
        _changeSummaryRows.OrderByDescending(row => row.Count).FirstOrDefault() is { } row
            ? $"{row.Name} ({row.Count:N0})"
            : "No changes yet";

    private string LatestEditText =>
        _editEntries.OrderByDescending(entry => entry.SavedAtUtc).FirstOrDefault() is { } entry
            ? $"{entry.AssetTag} - {entry.SavedAtUtc.ToLocalTime():MMM dd, HH:mm}"
            : "None";

    private IEnumerable<ChangeSummaryRow> ChangeSummaryRows => _changeSummaryRows;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _snapshot = await UploadedInventorySource.GetSnapshotAsync();
        var edits = await AssetEditStore.GetAllAsync();
        _editEntries = edits.Values
            .OrderByDescending(entry => entry.SavedAtUtc)
            .ToArray();
        _changeSummaryRows = BuildChangeSummary(_editEntries);
    }

    private IEnumerable<Metric> Metrics
    {
        get
        {
            var snapshot = _snapshot!;
            yield return new("Uploaded rows", snapshot.TotalRows.ToString("N0"), snapshot.SourceFileName, "100%", "#3B63F3", Icons.Material.Filled.TableRows, "info", 100);
            yield return new("Active assets", snapshot.ActiveAssets.ToString("N0"), "From Asset Status column", $"{Percent(snapshot.ActiveAssets, snapshot.TotalRows)}%", "#0E9F6E", Icons.Material.Filled.FactCheck, "success", Percent(snapshot.ActiveAssets, snapshot.TotalRows));
            yield return new("Pending verification", Math.Max(snapshot.TotalRows - _savedAssetEditCount, 0).ToString("N0"), $"{_savedAssetEditCount:N0} edited assets saved", $"{ReconciledPercent}% touched", "#D97706", Icons.Material.Filled.PendingActions, "warning", ReconciledPercent);
            yield return new("Duplicate tags", snapshot.DuplicateAssetTags.Count.ToString("N0"), "Held for review, not auto-merged", snapshot.DuplicateAssetTags.Count == 0 ? "Clear" : "Review", "#E5484D", Icons.Material.Filled.ContentCopy, snapshot.DuplicateAssetTags.Count == 0 ? "success" : "critical", snapshot.DuplicateAssetTags.Count == 0 ? 100 : 38);
        }
    }

    private IEnumerable<ProgressMetric> StatusMix =>
        GroupBy(_snapshot!.Assets.Select(asset => Clean(asset.AssetStatus, "Blank")), Color.Primary);

    private IEnumerable<ProgressMetric> DepartmentMix =>
        GroupBy(_snapshot!.Assets.Select(asset => Clean(asset.Department, "Unknown department")), Color.Secondary);

    private IEnumerable<BarMetric> AssetTypeBars
    {
        get
        {
            var groups = _snapshot!.Assets
                .GroupBy(asset => Clean(asset.AssetType, "Unknown"))
                .Select(group => new { Label = group.Key, Count = group.Count() })
                .OrderByDescending(group => group.Count)
                .Take(7)
                .ToArray();

            var max = Math.Max(groups.Select(group => group.Count).DefaultIfEmpty(1).Max(), 1);
            return groups.Select(group => new BarMetric(group.Label, group.Count, Math.Max(24, (int)Math.Round(group.Count / (double)max * 210))));
        }
    }

    private IEnumerable<LocationMetric> TopLocations
    {
        get
        {
            var groups = _snapshot!.Assets
                .GroupBy(asset => Clean(asset.AssetFloor, "Unknown"))
                .Select(group => new { Name = group.Key, Count = group.Count() })
                .OrderByDescending(group => group.Count)
                .Take(6)
                .ToArray();

            var max = Math.Max(groups.Select(group => group.Count).DefaultIfEmpty(1).Max(), 1);
            return groups.Select(group => new LocationMetric(group.Name, group.Count, Math.Clamp(group.Count / (double)max * 0.85, 0.1, 0.85)));
        }
    }

    private IEnumerable<RiskItem> UploadFindings
    {
        get
        {
            var snapshot = _snapshot!;
            if (snapshot.DuplicateAssetTags.Count > 0)
            {
                yield return new("Duplicate asset tags", string.Join(", ", snapshot.DuplicateAssetTags.Take(3).Select(item => $"{item.Value} ({item.Count})")), "Review", "critical", Icons.Material.Filled.ContentCopy, Color.Error);
            }

            if (snapshot.DuplicateSerialNumbers.Count > 0)
            {
                yield return new("Duplicate serial numbers", string.Join(", ", snapshot.DuplicateSerialNumbers.Take(3).Select(item => $"{item.Value} ({item.Count})")), "Review", "warning", Icons.Material.Filled.Fingerprint, Color.Warning);
            }

            if (snapshot.FormulaErrorCells > 0)
            {
                yield return new("Formula error cells", $"{snapshot.FormulaErrorCells:N0} cells contain error tokens in the workbook.", "Source issue", "warning", Icons.Material.Filled.Functions, Color.Warning);
            }

            if (_totalChangePointCount > 0)
            {
                yield return new("Saved reconciliation changes", $"{_totalChangePointCount:N0} field-level change points are classified from Asset Explorer saves.", "Tracking", "success", Icons.Material.Filled.StackedBarChart, Color.Success);
            }
            else
            {
                yield return new("Verification records", "No field-level reconciliation changes have been saved yet. Edit and save assets to start the summary chart.", "Not started", "info", Icons.Material.Filled.QrCodeScanner, Color.Primary);
            }
        }
    }

    private static IReadOnlyList<ChangeSummaryRow> BuildChangeSummary(IEnumerable<AssetEditEntry> entries)
    {
        var counts = entries
            .SelectMany(entry => entry.Changes ?? [])
            .Where(change => !string.IsNullOrWhiteSpace(change.ChangeType))
            .GroupBy(change => Clean(change.ChangeType, "Other Update"), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.Count(), StringComparer.OrdinalIgnoreCase);

        if (counts.Count == 0)
        {
            return [];
        }

        var orderedTypes = CoreChangeOrder
            .Concat(counts.Keys.Except(CoreChangeOrder, StringComparer.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();

        var total = Math.Max(counts.Values.Sum(), 1);
        return orderedTypes
            .Where(type => counts.TryGetValue(type, out var count) && count > 0)
            .Select(type => new ChangeSummaryRow(type, counts[type], Percent(counts[type], total), ChangeTone(type)))
            .ToArray();
    }

    private static string ChangeTone(string changeType) =>
        changeType switch
        {
            "Location Change" => "primary",
            "Sticker Mismatch" => "danger",
            "User Mismatch" => "violet",
            "Serial Mismatch" => "warning",
            "Department Change" => "cyan",
            "Status Change" => "success",
            "Asset Type Variance" => "indigo",
            "Custodian Change" => "violet",
            "Device Details Change" => "teal",
            "Warranty Change" => "amber",
            "Security Posture Change" => "danger",
            _ => "neutral"
        };

    private static IEnumerable<ProgressMetric> GroupBy(IEnumerable<string> values, Color color)
    {
        var groups = values.GroupBy(value => value)
            .Select(group => new { Name = group.Key, Count = group.Count() })
            .OrderByDescending(group => group.Count)
            .Take(6)
            .ToArray();

        var total = Math.Max(groups.Sum(group => group.Count), 1);
        return groups.Select(group => new ProgressMetric(group.Name, group.Count, (int)Math.Round(group.Count / (double)total * 100), color));
    }

    private static string Clean(string? value, string fallback) =>
        string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();

    private static int Percent(int value, int total) =>
        total <= 0 ? 0 : (int)Math.Round(value / (double)total * 100);

    private sealed record Metric(string Label, string Value, string Delta, string Trend, string Accent, string Icon, string Tone, int Progress);
    private sealed record BarMetric(string Label, int Count, int Height);
    private sealed record ProgressMetric(string Name, int Count, int Percent, Color Color);
    private sealed record LocationMetric(string Name, int Count, double Heat);
    private sealed record ChangeSummaryRow(string Name, int Count, int Percent, string Tone);
    private sealed record RiskItem(string Title, string Detail, string Status, string Tone, string Icon, Color Color);
}
